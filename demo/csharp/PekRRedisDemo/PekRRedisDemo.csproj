<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PekRRedisDemo</AssemblyName>
    <RootNamespace>PekRRedisDemo</RootNamespace>
    <AssemblyTitle>Pek.RRedis 互通验证 Demo（C# 侧）</AssemblyTitle>
    <Description>与 Rust 侧 Pek.RRedis Demo 相互验证：写入同一套固定样本，互相读取校验，证明两端数据格式互通</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>CS7035;NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 直接引用 DH.NRedis 源码工程，Demo 与库始终同源 -->
    <ProjectReference Include="..\..\..\..\..\Pek.FrameWork\DH.NRedis\DH.NRedis\DH.NRedis.csproj" />
  </ItemGroup>

</Project>
